{
  "openapi": "3.0.1",
  "info": {
    "title": "Synthetic annotation reproduction",
    "version": "1.0"
  },
  "servers": [
    {
      "url": "https://example.test"
    }
  ],
  "paths": {
    "/items": {
      "post": {
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "name": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "id",
                    "name"
                  ],
                  "example": {
                    "id": "11111111-1111-4111-8111-111111111111",
                    "name": "example"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string",
                        "format": "uuid"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/items/{itemId}": {
      "parameters": [
        {
          "name": "itemId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        }
      ],
      "delete": {
        "responses": {
          "200": {
            "description": "OK"
          }
        },
        "x-restler-annotations": [
          {
            "producer_endpoint": "/items",
            "producer_method": "POST",
            "producer_resource_name": "/[0]/id",
            "consumer_param": "itemId"
          }
        ]
      }
    }
  }
}